{
  "cells": [
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "print(\"PART 1\")\n",
        "books = 24\n",
        "war_years = 10\n",
        "journey_years = 10\n",
        "\n",
        "total_years_away = war_years + journey_years\n",
        "print(total_years_away)\n",
        "\n",
        "books_per_week = books // 7\n",
        "leftover_books = books % 7\n",
        "print(books_per_week)\n",
        "print(leftover_books)\n",
        "\n",
        "print(type(books))\n",
        "print(type(total_years_away))\n",
        "print(type(books_per_week))\n",
        "\n",
        "\n",
        "hero = \"Odysseus\"\n",
        "epithet = \"man of a great journey\"\n",
        "print(hero + \" \" + epithet)\n",
        "print(hero, epithet)\n",
        "homer_quote = \"\\\"the man of twists and turns.\\\"\"\n",
        "\n",
        "\n",
        "years_match = war_years == journey_years\n",
        "print(years_match)\n",
        "book_number = 3\n",
        "is_first_book = book_number == 1\n",
        "is_last_book = book_number == 24\n",
        "is_bookend = is_first_book or is_last_book\n",
        "print(book_number, is_bookend)\n",
        "\n",
        "\n",
        "book_number = 12\n",
        "my_guess = \"Odysseus will encounter the sirens and resist their song.\"\n",
        "is_double_digit = book_number >= 10\n",
        "print(book_number)\n",
        "print(my_guess)\n",
        "print(is_double_digit)\n",
        "print(type(book_number))\n",
        "print(type(my_guess))\n",
        "print(type(is_double_digit))"
      ],
      "id": "1f2ad476",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "print(\"\\nPART 2\")\n",
        "with open(\"odyssey.txt\", encoding=\"utf-8\") as f:\n",
        "    text = f.read()\n",
        "words = text.split()\n",
        "print(len(words))\n",
        "print(words[0:20])\n",
        "print(words[149:158])\n",
        "\n",
        "unique_words = set(words)\n",
        "print(len(unique_words))\n",
        "\n",
        "ttr = len(unique_words) / len(words)\n",
        "print(ttr)\n",
        "print(\"The TTR for the Odyssey is lower than for the other texts. It is likely that TTR decreases as the length of a text increases as certain grammatical structures and common words are used much more often the more is written in total.\")\n",
        "\n",
        "print(\"Odysseus count: \", text.count(\"Odysseus\"))\n",
        "position = text.find(\"Odysseus\")\n",
        "print(text[position - 150 : position + 150])\n",
        "\n",
        "\"Ulysses\" in text\n",
        "print(\"Ulysses count: \", text.count(\"Ulysses\"))\n",
        "\n",
        "\n",
        "character_counts = {\n",
        "    \"Ulysses\": text.count(\"Ulysses\"),\n",
        "    \"Penelope\": text.count(\"Penelope\"),\n",
        "    \"Telemachus\": text.count(\"Telemachus\"),\n",
        "    \"Minerva\": text.count(\"Minerva\")\n",
        "}\n",
        "print(character_counts)\n",
        "print(\"The name Ulysses occurs the most often in the text of the Odyssey.\")\n",
        "\n",
        "character_counts.update({\"Achilles\": text.count(\"Achilles\")})\n",
        "print(character_counts)"
      ],
      "id": "8c191020",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "print(\"\\nPART 3\")\n",
        "print(\"One thing that surprised me about working with a full downloaded text compared to short lists like in class is that it actually takes a moment for the computer to process the text, unlike the instant feedback that occurs with short texts. The Project Gutenburg license at the start and end is likely insignificant to the overall data of the massive text that is the Odyssey. I believe this because the license is not very long, and the full text of the Odyssey is absolutely massive in comparison. Dict felt the most natural for character-counting because it is unordered data, only a label and corresponding data, when sorting the characters by any specific means would likely not be useful\")"
      ],
      "id": "f8cd1b0c",
      "execution_count": null,
      "outputs": []
    }
