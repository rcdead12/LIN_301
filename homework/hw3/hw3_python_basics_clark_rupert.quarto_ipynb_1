    "print(\"\\nPART 2\")\n",
    "with open(\"odyssey.txt\", encoding=\"utf-8\") as f:\n",
    "    text = f.read()\n",
    "words = text.split()\n",
    "print(len(words))\n",
    "print(words[0:20])\n",
    "print(words[149:158])\n",
    "\n",
    "unique_words = set(words)\n",
    "print(len(unique_words))\n",
    "\n",
    "ttr = len(unique_words) / len(words)\n",
    "print(ttr)\n",
    "print(\"The TTR for the Odyssey is lower than for the other texts. It is likely that TTR decreases as the length of a text increases as certain grammatical structures and common words are used much more often the more is written in total.\")\n",
    "\n",
    "print(\"Odysseus count: \", text.count(\"Odysseus\"))\n",
    "position = text.find(\"Odysseus\")\n",
    "print(text[position - 150 : position + 150])\n",
    "\n",
    "\"Ulysses\" in text\n",
