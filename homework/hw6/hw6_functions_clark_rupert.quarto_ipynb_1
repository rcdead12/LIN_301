   "source": [
    "4.  Use your `cv` column to check the claims above. Does any word have two consonants in a row? Does any word end in a consonant?"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "85f65239",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Words that have two consonants in a row: []\n",
      "Words that end in a consonant: []\n"
     ]
    }
   ],
   "source": [
    "two_c_words = []\n",
    "ends_c_words = []\n",
    "\n",
    "for w in hi_df[\"word\"]:\n",
    "    cv_form = hi_df.loc[hi_df.index[hi_df[\"word\"] == w]][\"cv\"]\n",
    "    is_c = False\n",
    "    for l in cv_form:\n",
    "        if l == \"C\" and is_c:    # checks if character is a consonant & previous character is to (stored in is_c)\n",
    "            two_c_words.append(w)\n",
    "        elif l == \"C\":  # if character is a consonant\n",
    "            is_c = True\n",
    "        else:\n",
    "            is_c = False\n",
    "    \n",
    "    for l in cv_form:\n",
    "        if l == \"C\" and cv_form.index(l) == [-1]:\n",
    "            ends_c_words.append(w)\n",
    "\n",
    "print(\"Words that have two consonants in a row:\", two_c_words)\n",
    "print(\"Words that end in a consonant:\", ends_c_words)"
   ]
